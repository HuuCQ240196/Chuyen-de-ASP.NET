@model IEnumerable<ProLap.Models.Product>

@{
    ViewData["Title"] = "Trang chủ";

    int currentPage = ViewBag.CurrentPage ?? 1;
    int totalPages = ViewBag.TotalPages ?? 0;
    int totalProducts = ViewBag.TotalProducts ?? 0;
}

<div class="container mt-4">

    <div class="home-hero text-center mb-4">

        <div class="mb-2">
            <span class="badge rounded-pill bg-primary px-3 py-2">
                ProLap Store
            </span>
        </div>

        <h1 class="fw-bold mb-2">
            Laptop nổi bật
        </h1>

        <p class="text-muted mb-0">
            Khám phá các mẫu laptop phù hợp cho
            học tập, làm việc và giải trí
        </p>

    </div>


    <!-- ========================================= -->
    <!-- TÌM KIẾM + LỌC SẢN PHẨM -->
    <!-- ========================================= -->

    <div class="card shadow-sm mb-4">

        <div class="card-body">

            <form asp-controller="Home"
                  asp-action="Index"
                  method="get">

                <div class="row g-3 align-items-end">

                    <!-- TÌM KIẾM -->
                    <div class="col-md-4">

                        <label class="form-label">
                            Tìm kiếm sản phẩm
                        </label>

                        <input type="text"
                               name="searchString"
                               value="@ViewBag.SearchString"
                               class="form-control"
                               placeholder="Nhập tên laptop..." />

                    </div>


                    <!-- THƯƠNG HIỆU -->
                    <div class="col-md-3">

                        <label class="form-label">
                            Thương hiệu
                        </label>

                        <select name="brandId"
                                class="form-select"
                                asp-items="ViewBag.BrandId">

                            <option value="">
                                -- Tất cả thương hiệu --
                            </option>

                        </select>

                    </div>


                    <!-- DANH MỤC -->
                    <div class="col-md-3">

                        <label class="form-label">
                            Danh mục
                        </label>

                        <select name="categoryId"
                                class="form-select"
                                asp-items="ViewBag.CategoryId">

                            <option value="">
                                -- Tất cả danh mục --
                            </option>

                        </select>

                    </div>


                    <!-- NÚT -->
                    <div class="col-md-2">

                        <div class="d-grid gap-2">

                            <button type="submit"
                                    class="btn btn-primary">

                                Tìm kiếm

                            </button>

                            <a asp-controller="Home"
                               asp-action="Index"
                               class="btn btn-outline-secondary">

                                Xóa bộ lọc

                            </a>

                        </div>

                    </div>

                </div>

            </form>

        </div>

    </div>


    <!-- ========================================= -->
    <!-- THÔNG TIN KẾT QUẢ -->
    <!-- ========================================= -->
    @if (totalProducts > 0)
    {
        <div class="d-flex justify-content-between
            align-items-center mb-3">

            <div class="text-muted">

                Tìm thấy
                <strong>@totalProducts</strong>
                sản phẩm

            </div>

            @if (totalPages > 1)
            {
                <div class="text-muted">

                    Trang
                    <strong>@currentPage</strong>
                    /
                    <strong>@totalPages</strong>

                </div>
            }

        </div>
    }


    <!-- ========================================= -->
    <!-- DANH SÁCH SẢN PHẨM -->
    <!-- ========================================= -->
    @if (Model != null && Model.Any())
    {
        <div class="row g-4">

            @foreach (var product in Model)
            {
                <div class="col-12 col-sm-6 col-md-4 col-lg-3">

                    <div class="card h-100 border-0 shadow-sm product-card">

                        <!-- HÌNH ẢNH -->
                        <div class="position-relative bg-white p-3">

                            @if (!string.IsNullOrEmpty(product.ImageUrl))
                            {
                                <img src="@product.ImageUrl"
                                     alt="@product.Name"
                                     class="card-img-top product-image" />
                            }
                            else
                            {
                                <div class="border rounded text-muted d-flex
                                    align-items-center justify-content-center"
                                     style="height: 200px;">
                                    Chưa có hình ảnh
                                </div>
                            }

                            <!-- TÌNH TRẠNG TỒN KHO -->
                            <div class="position-absolute top-0 end-0 m-2">

                                @if (product.Stock > 0)
                                {
                                    <span class="badge bg-success">
                                        Còn hàng
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-danger">
                                        Hết hàng
                                    </span>
                                }

                            </div>

                        </div>

                        <!-- THÔNG TIN -->
                        <div class="card-body d-flex flex-column">

                            <!-- THƯƠNG HIỆU -->
                            @if (product.Brand != null)
                            {
                                <div class="small text-uppercase text-muted fw-semibold mb-1">
                                    @product.Brand.Name
                                </div>
                            }

                            <!-- TÊN -->
                            <h5 class="card-title fw-bold mb-3 product-name">
                                @product.Name
                            </h5>

                            <!-- THÔNG SỐ -->
                            <div class="small text-muted mb-3">

                                @if (!string.IsNullOrEmpty(product.CPU))
                                {
                                    <div class="mb-1">
                                        <strong class="text-dark">CPU:</strong>
                                        @product.CPU
                                    </div>
                                }

                                @if (!string.IsNullOrEmpty(product.RAM))
                                {
                                    <div class="mb-1">
                                        <strong class="text-dark">RAM:</strong>
                                        @product.RAM
                                    </div>
                                }

                                @if (!string.IsNullOrEmpty(product.Storage))
                                {
                                    <div>
                                        <strong class="text-dark">Ổ cứng:</strong>
                                        @product.Storage
                                    </div>
                                }

                            </div>

                            <!-- GIÁ + NÚT -->
                            <div class="mt-auto">

                                <div class="mb-3">

                                    <div class="small text-muted">
                                        Giá bán
                                    </div>

                                    <div class="fs-4 fw-bold text-danger">
                                        @product.Price.ToString("N0") đ
                                    </div>

                                </div>

                                <a asp-controller="Products"
                                   asp-action="Details"
                                   asp-route-id="@product.Id"
                                   class="btn btn-primary w-100 rounded-pill fw-semibold">

                                    Xem chi tiết

                                </a>

                            </div>

                        </div>

                    </div>

                </div>
            }

        </div>


        <!-- ========================================= -->
        <!-- PHÂN TRANG -->
        <!-- ========================================= -->
        @if (totalPages > 1)
        {
            <nav class="mt-5"
                 aria-label="Phân trang sản phẩm">

                <ul class="pagination justify-content-center">


                    <!-- ================================= -->
                    <!-- NÚT TRƯỚC -->
                    <!-- ================================= -->

                    <li class="page-item
                        @(currentPage == 1 ? "disabled" : "")">

                        <a class="page-link"
                           asp-controller="Home"
                           asp-action="Index"
                           asp-route-page="@(currentPage - 1)"
                           asp-route-searchString="@ViewBag.SearchString"
                           asp-route-brandId="@ViewBag.SelectedBrandId"
                           asp-route-categoryId="@ViewBag.SelectedCategoryId">

                            &laquo; Trước

                        </a>

                    </li>


                    <!-- ================================= -->
                    <!-- CÁC SỐ TRANG -->
                    <!-- ================================= -->
                    @for (int i = 1; i <= totalPages; i++)
                    {
                        <li class="page-item
                            @(i == currentPage ? "active" : "")">

                            <a class="page-link"
                               asp-controller="Home"
                               asp-action="Index"
                               asp-route-page="@i"
                               asp-route-searchString="@ViewBag.SearchString"
                               asp-route-brandId="@ViewBag.SelectedBrandId"
                               asp-route-categoryId="@ViewBag.SelectedCategoryId">

                                @i

                            </a>

                        </li>
                    }


                    <!-- ================================= -->
                    <!-- NÚT SAU -->
                    <!-- ================================= -->

                    <li class="page-item
                        @(currentPage == totalPages ? "disabled" : "")">

                        <a class="page-link"
                           asp-controller="Home"
                           asp-action="Index"
                           asp-route-page="@(currentPage + 1)"
                           asp-route-searchString="@ViewBag.SearchString"
                           asp-route-brandId="@ViewBag.SelectedBrandId"
                           asp-route-categoryId="@ViewBag.SelectedCategoryId">

                            Sau &raquo;

                        </a>

                    </li>

                </ul>

            </nav>
        }
    }
    else
    {
        <!-- ========================================= -->
        <!-- KHÔNG CÓ SẢN PHẨM -->
        <!-- ========================================= -->

        <div class="alert alert-warning text-center">

            Không tìm thấy sản phẩm phù hợp.

        </div>
    }

</div>
<style>
    .product-card {
        border-radius: 16px;
        overflow: hidden;
        transition: transform 0.2s ease, box-shadow 0.2s ease;
    }

        .product-card:hover {
            transform: translateY(-6px);
            box-shadow: 0 12px 28px rgba(0, 0, 0, 0.12) !important;
        }

    .product-image {
        height: 200px;
        object-fit: contain;
        transition: transform 0.25s ease;
    }

    .product-card:hover .product-image {
        transform: scale(1.04);
    }

    .product-name {
        min-height: 48px;
        line-height: 1.35;
    }

    .product-card .btn-primary {
        transition: all 0.2s ease;
    }

        .product-card .btn-primary:hover {
            transform: translateY(-1px);
        }

    .home-hero {
        padding: 25px 15px;
    }

        .home-hero h1 {
            font-size: 2.2rem;
            letter-spacing: -0.5px;
        }

        .home-hero p {
            font-size: 1.05rem;
        }
</style>
