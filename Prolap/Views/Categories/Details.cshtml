@model ProLap.Models.Category

@{
    ViewData["Title"] = "Chi tiết danh mục";
}

<h1>Chi tiết danh mục</h1>

<div>
    <h4>Thông tin danh mục</h4>
    <hr />

    <dl class="row">
        <dt class="col-sm-3">
            Tên danh mục
        </dt>

        <dd class="col-sm-9">
            @Html.DisplayFor(model => model.Name)
        </dd>
    </dl>
</div>

<div>
    <a asp-action="Edit"
       asp-route-id="@Model?.Id"
       class="btn btn-warning">
        Sửa
    </a>

    <a asp-action="Index"
       class="btn btn-secondary">
        Quay lại
    </a>
</div>