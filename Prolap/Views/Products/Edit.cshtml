@model ProLap.Models.Product

@{
    ViewData["Title"] = "Sửa sản phẩm";
}

<h1>Sửa sản phẩm</h1>

<h4>Thông tin sản phẩm</h4>
<hr />

<div class="row">
    <div class="col-md-8">

        <form asp-action="Edit"
              method="post"
              enctype="multipart/form-data">

            <div asp-validation-summary="ModelOnly"
                 class="text-danger">
            </div>

            <input type="hidden" asp-for="Id" />

            <div class="form-group mb-3">
                <label asp-for="Name" class="control-label">
                    Tên sản phẩm
                </label>

                <input asp-for="Name"
                       class="form-control" />

                <span asp-validation-for="Name"
                      class="text-danger">
                </span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="Price" class="control-label">
                    Giá bán
                </label>

                <input asp-for="Price"
                       class="form-control"
                       type="number"
                       min="0" />

                <span asp-validation-for="Price"
                      class="text-danger">
                </span>
            </div>

            <div class="row">

                <div class="col-md-6">
                    <div class="form-group mb-3">
                        <label asp-for="CPU" class="control-label">
                            CPU
                        </label>

                        <input asp-for="CPU"
                               class="form-control" />

                        <span asp-validation-for="CPU"
                              class="text-danger">
                        </span>
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="form-group mb-3">
                        <label asp-for="RAM" class="control-label">
                            RAM
                        </label>

                        <input asp-for="RAM"
                               class="form-control" />

                        <span asp-validation-for="RAM"
                              class="text-danger">
                        </span>
                    </div>
                </div>

            </div>

            <div class="row">

                <div class="col-md-6">
                    <div class="form-group mb-3">
                        <label asp-for="Storage" class="control-label">
                            Ổ cứng
                        </label>

                        <input asp-for="Storage"
                               class="form-control" />

                        <span asp-validation-for="Storage"
                              class="text-danger">
                        </span>
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="form-group mb-3">
                        <label asp-for="GPU" class="control-label">
                            Card đồ họa
                        </label>

                        <input asp-for="GPU"
                               class="form-control" />

                        <span asp-validation-for="GPU"
                              class="text-danger">
                        </span>
                    </div>
                </div>

            </div>

            <div class="row">

                <div class="col-md-6">
                    <div class="form-group mb-3">
                        <label asp-for="Screen" class="control-label">
                            Màn hình
                        </label>

                        <input asp-for="Screen"
                               class="form-control" />

                        <span asp-validation-for="Screen"
                              class="text-danger">
                        </span>
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="form-group mb-3">
                        <label asp-for="Stock" class="control-label">
                            Số lượng tồn kho
                        </label>

                        <input asp-for="Stock"
                               class="form-control"
                               type="number"
                               min="0" />

                        <span asp-validation-for="Stock"
                              class="text-danger">
                        </span>
                    </div>
                </div>

            </div>

            <div class="form-group mb-3">
                <label class="control-label">
                    Hình ảnh sản phẩm
                </label>

                @if (!string.IsNullOrEmpty(Model.ImageUrl))
                {
                    <div class="mb-2">
                        <p class="mb-1">
                            Ảnh hiện tại:
                        </p>

                        <img src="@Model.ImageUrl"
                             alt="@Model.Name"
                             class="img-thumbnail"
                             style="max-width: 220px;
                        max-height: 180px;
                        object-fit: contain;" />
                    </div>
                }
                else
                {
                    <p class="text-muted mb-2">
                        Sản phẩm hiện chưa có hình ảnh.
                    </p>
                }

                <input type="file"
                       name="ImageFile"
                       class="form-control"
                       accept="image/*" />

                <small class="text-muted">
                    Nếu không chọn ảnh mới, hệ thống sẽ giữ nguyên ảnh hiện tại.
                </small>
            </div>

            <div class="form-group mb-3">
                <label asp-for="Description" class="control-label">
                    Mô tả sản phẩm
                </label>

                <textarea asp-for="Description"
                          class="form-control"
                          rows="4"></textarea>

                <span asp-validation-for="Description"
                      class="text-danger">
                </span>
            </div>

            <div class="row">

                <div class="col-md-6">
                    <div class="form-group mb-3">

                        <label asp-for="BrandId" class="control-label">
                            Thương hiệu
                        </label>

                        <select asp-for="BrandId"
                                class="form-select"
                                asp-items="ViewBag.BrandId">

                            <option value="">
                                -- Chọn thương hiệu --
                            </option>

                        </select>

                        <span asp-validation-for="BrandId"
                              class="text-danger">
                        </span>

                    </div>
                </div>

                <div class="col-md-6">
                    <div class="form-group mb-3">

                        <label asp-for="CategoryId" class="control-label">
                            Danh mục
                        </label>

                        <select asp-for="CategoryId"
                                class="form-select"
                                asp-items="ViewBag.CategoryId">

                            <option value="">
                                -- Chọn danh mục --
                            </option>

                        </select>

                        <span asp-validation-for="CategoryId"
                              class="text-danger">
                        </span>

                    </div>
                </div>

            </div>

            <div class="form-group mt-3">

                <input type="submit"
                       value="Lưu thay đổi"
                       class="btn btn-primary" />

                <a asp-action="Index"
                   class="btn btn-secondary">
                    Quay lại
                </a>

            </div>

        </form>

    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}