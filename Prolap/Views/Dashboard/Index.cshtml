@using System.Text.Json

@{
    ViewData["Title"] = "Dashboard quản trị";

    string chartLabels =
        JsonSerializer.Serialize(ViewBag.ChartLabels);

    string chartData =
        JsonSerializer.Serialize(ViewBag.ChartData);

    string revenueChartLabels =
        JsonSerializer.Serialize(ViewBag.RevenueChartLabels);

    string revenueChartData =
        JsonSerializer.Serialize(ViewBag.RevenueChartData);
}

<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h1 class="mb-1">
                Dashboard quản trị
            </h1>

            <p class="text-muted mb-0">
                Tổng quan hoạt động của hệ thống ProLap
            </p>
        </div>

    </div>


    <!-- ===================================== -->
    <!-- HÀNG 1: THỐNG KÊ TỔNG QUAN -->
    <!-- ===================================== -->

    <div class="row g-4 mb-4">

        <div class="col-md-6 col-xl-3">

            <div class="card shadow-sm h-100">

                <div class="card-body">

                    <h6 class="text-muted">
                        Tổng sản phẩm
                    </h6>

                    <h2 class="fw-bold mb-0">
                        @ViewBag.TotalProducts
                    </h2>

                </div>

            </div>

        </div>


        <div class="col-md-6 col-xl-3">

            <div class="card shadow-sm h-100">

                <div class="card-body">

                    <h6 class="text-muted">
                        Tổng đơn hàng
                    </h6>

                    <h2 class="fw-bold mb-0">
                        @ViewBag.TotalOrders
                    </h2>

                </div>

            </div>

        </div>


        <div class="col-md-6 col-xl-3">

            <div class="card shadow-sm h-100">

                <div class="card-body">

                    <h6 class="text-muted">
                        Sản phẩm sắp hết
                    </h6>

                    <h2 class="fw-bold text-warning mb-0">
                        @ViewBag.LowStockProducts
                    </h2>

                </div>

            </div>

        </div>


        <div class="col-md-6 col-xl-3">

            <div class="card shadow-sm h-100">

                <div class="card-body">

                    <h6 class="text-muted">
                        Doanh thu
                    </h6>

                    <h2 class="fw-bold text-success mb-0">
                        @(((decimal)ViewBag.TotalRevenue).ToString("N0")) đ
                    </h2>

                    <small class="text-muted">
                        Chỉ tính đơn hoàn thành
                    </small>

                </div>

            </div>

        </div>

    </div>


    <!-- ===================================== -->
    <!-- HÀNG 2: TRẠNG THÁI ĐƠN HÀNG -->
    <!-- ===================================== -->

    <div class="card shadow-sm mb-4">

        <div class="card-header">

            <h5 class="mb-0">
                Trạng thái đơn hàng
            </h5>

        </div>

        <div class="card-body">

            <div class="row g-3">

                <div class="col-md-6 col-xl">

                    <div class="border rounded p-3 text-center">

                        <div class="text-muted mb-2">
                            Chờ xác nhận
                        </div>

                        <div class="fs-3 fw-bold text-warning">
                            @ViewBag.PendingOrders
                        </div>

                    </div>

                </div>


                <div class="col-md-6 col-xl">

                    <div class="border rounded p-3 text-center">

                        <div class="text-muted mb-2">
                            Đã xác nhận
                        </div>

                        <div class="fs-3 fw-bold text-primary">
                            @ViewBag.ConfirmedOrders
                        </div>

                    </div>

                </div>


                <div class="col-md-6 col-xl">

                    <div class="border rounded p-3 text-center">

                        <div class="text-muted mb-2">
                            Đang giao
                        </div>

                        <div class="fs-3 fw-bold text-info">
                            @ViewBag.ShippingOrders
                        </div>

                    </div>

                </div>


                <div class="col-md-6 col-xl">

                    <div class="border rounded p-3 text-center">

                        <div class="text-muted mb-2">
                            Hoàn thành
                        </div>

                        <div class="fs-3 fw-bold text-success">
                            @ViewBag.CompletedOrders
                        </div>

                    </div>

                </div>


                <div class="col-md-6 col-xl">

                    <div class="border rounded p-3 text-center">

                        <div class="text-muted mb-2">
                            Đã hủy
                        </div>

                        <div class="fs-3 fw-bold text-danger">
                            @ViewBag.CancelledOrders
                        </div>

                    </div>

                </div>

            </div>

        </div>

    </div>


    <!-- ===================================== -->
    <!-- HÀNG 3: BIỂU ĐỒ -->
    <!-- ===================================== -->

    <div class="card shadow-sm mb-4">

        <div class="card-header">

            <h5 class="mb-0">
                Biểu đồ trạng thái đơn hàng
            </h5>

        </div>

        <div class="card-body">

            <div style="height: 350px;">

                <canvas id="orderStatusChart"></canvas>

            </div>

        </div>

    </div>
    <!-- ===================================== -->
    <!-- BIỂU ĐỒ DOANH THU THEO THÁNG -->
    <!-- ===================================== -->

    <div class="card shadow-sm mb-4">

        <div class="card-header">

            <h5 class="mb-0">
                Doanh thu theo tháng - Năm @ViewBag.RevenueYear
            </h5>

        </div>

        <div class="card-body">

            <div style="height: 350px;">

                <canvas id="monthlyRevenueChart"></canvas>

            </div>

        </div>

    </div>


    <!-- ===================================== -->
    <!-- HÀNG 4: TRUY CẬP NHANH -->
    <!-- ===================================== -->

    <div class="card shadow-sm">

        <div class="card-header">

            <h5 class="mb-0">
                Truy cập nhanh
            </h5>

        </div>

        <div class="card-body">

            <div class="row g-3">

                <div class="col-md-6 col-lg-3">

                    <a asp-controller="Products"
                       asp-action="Index"
                       class="btn btn-outline-primary w-100">

                        Quản lý sản phẩm

                    </a>

                </div>


                <div class="col-md-6 col-lg-3">

                    <a asp-controller="Brands"
                       asp-action="Index"
                       class="btn btn-outline-secondary w-100">

                        Quản lý thương hiệu

                    </a>

                </div>


                <div class="col-md-6 col-lg-3">

                    <a asp-controller="Categories"
                       asp-action="Index"
                       class="btn btn-outline-dark w-100">

                        Quản lý danh mục

                    </a>

                </div>


                <div class="col-md-6 col-lg-3">

                    <a asp-controller="Orders"
                       asp-action="Index"
                       class="btn btn-outline-success w-100">

                        Quản lý đơn hàng

                    </a>

                </div>

            </div>

        </div>

    </div>

</div>


@section Scripts {

    <!-- ===================================== -->
    <!-- CHART.JS -->
    <!-- ===================================== -->

    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

    <script>

        const chartLabels = @Html.Raw(chartLabels);
        const chartData = @Html.Raw(chartData);

        const chartCanvas =
            document.getElementById('orderStatusChart');

        new Chart(chartCanvas, {

            type: 'bar',

            data: {

                labels: chartLabels,

                datasets: [
                    {
                        label: 'Số đơn hàng',

                        data: chartData,

                        backgroundColor: [
                            'rgba(255, 193, 7, 0.7)',
                            'rgba(13, 110, 253, 0.7)',
                            'rgba(13, 202, 240, 0.7)',
                            'rgba(25, 135, 84, 0.7)',
                            'rgba(220, 53, 69, 0.7)'
                        ],

                        borderColor: [
                            'rgb(255, 193, 7)',
                            'rgb(13, 110, 253)',
                            'rgb(13, 202, 240)',
                            'rgb(25, 135, 84)',
                            'rgb(220, 53, 69)'
                        ],

                        borderWidth: 1
                    }
                ]

            },

            options: {

                responsive: true,

                maintainAspectRatio: false,

                plugins: {

                    legend: {
                        display: false
                    }

                },

                scales: {

                    y: {

                        beginAtZero: true,

                        ticks: {

                            stepSize: 1

                        }

                    }

                }

            }

        });

    </script>

}
<script>

    const revenueChartLabels =
            @Html.Raw(revenueChartLabels);

    const revenueChartData =
            @Html.Raw(revenueChartData);

    const revenueCanvas =
        document.getElementById('monthlyRevenueChart');

    new Chart(revenueCanvas, {

        type: 'bar',

        data: {

            labels: revenueChartLabels,

            datasets: [
                {
                    label: 'Doanh thu',

                    data: revenueChartData,

                    backgroundColor:
                        'rgba(25, 135, 84, 0.7)',

                    borderColor:
                        'rgb(25, 135, 84)',

                    borderWidth: 1
                }
            ]

        },

        options: {

            responsive: true,

            maintainAspectRatio: false,

            plugins: {

                legend: {
                    display: false
                },

                tooltip: {

                    callbacks: {

                        label: function(context) {

                            const value =
                                context.raw ?? 0;

                            return 'Doanh thu: ' +
                                Number(value)
                                    .toLocaleString('vi-VN') +
                                ' đ';
                        }
                    }
                }
            },

            scales: {

                y: {

                    beginAtZero: true,

                    ticks: {

                        callback: function(value) {

                            return Number(value)
                                .toLocaleString('vi-VN') +
                                ' đ';
                        }

                    }

                }

            }

        }

    });

</script>